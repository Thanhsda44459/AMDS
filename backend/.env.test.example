# Cấu hình cho test tích hợp (TEST-003).
#
#   docker compose -f docker-compose.test.yml up -d --wait
#   cd backend
#   $env:MONGODB_URI="mongodb://localhost:27018/?directConnection=true"
#   $env:REDIS_URL="redis://localhost:6380"
#   pytest -m integration
#
# directConnection=true là bắt buộc: replica set một node có tên "mongodb:27017"
# mà máy host không phân giải được tên đó. directConnection bỏ qua bước tìm
# primary theo tên, kết nối thẳng vào node đã publish ở 27018.
#
# KHÔNG dùng file này cho dev: cổng 27017/6379 của docker-compose.yml vẫn là
# cổng chuẩn cho việc chạy app.

MONGODB_URI=mongodb://localhost:27018/?directConnection=true
REDIS_URL=redis://localhost:6380